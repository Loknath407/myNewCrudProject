
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard {
        background: #f4f7fb;
        min-height: 85vh;
        padding: 30px;
        border-radius: 16px;
    }

    .dashboard-card {
        background: white;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        transition: transform 0.2s ease;
        height: 100%;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 23px;
        margin-bottom: 18px;
    }

    .icon-blue { background: #e8f0ff; }
    .icon-green { background: #e5f8ee; }
    .icon-orange { background: #fff1df; }

    .guide-item {
        padding: 16px;
        border-radius: 10px;
        background: #f8fafc;
        height: 100%;
    }

    .guide-number {
        color: #0d6efd;
        font-weight: bold;
        margin-right: 8px;
    }
</style>

<div class="dashboard">

    <div class="mb-5">
        <h2 class="fw-bold mb-2">Employee Dashboard</h2>
        <p class="text-muted mb-0">
            Manage your employee records in one place.
        </p>
    </div>

    <!-- Live Employee Count -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-4">
            <div class="dashboard-card p-4">
                <div class="stat-icon icon-blue">👥</div>
                <p class="text-muted mb-2">Total Employees</p>
                <h2 class="fw-bold mb-2">@ViewBag.EmployeeCount</h2>
                <p class="text-muted small mb-0">
                    Total employee records in the database.
                </p>
            </div>
        </div>
    </div>

    <!-- Employee Management Cards -->
    <div class="row g-4 mb-5">

        <div class="col-md-6 col-xl-4">
            <div class="dashboard-card p-4">
                <div class="stat-icon icon-blue">👥</div>
                <p class="text-muted mb-2">Employee Records</p>
                <h4 class="fw-bold mb-2">Manage Employees</h4>
                <p class="text-muted small">
                    View and search all employee records.
                </p>
                <a asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-outline-primary mt-2">
                    View Employees →
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="dashboard-card p-4">
                <div class="stat-icon icon-green">➕</div>
                <p class="text-muted mb-2">Create Records</p>
                <h4 class="fw-bold mb-2">Add New Employee</h4>
                <p class="text-muted small">
                    Register a new employee in the system.
                </p>
                <a asp-controller="Employees"
                   asp-action="Create"
                   class="btn btn-outline-success mt-2">
                    Create Employee →
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="dashboard-card p-4">
                <div class="stat-icon icon-orange">✏️</div>
                <p class="text-muted mb-2">Record Maintenance</p>
                <h4 class="fw-bold mb-2">Update Details</h4>
                <p class="text-muted small">
                    Edit employee information when needed.
                </p>
                <a asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-outline-warning mt-2">
                    Manage Records →
                </a>
            </div>
        </div>

    </div>

    <!-- Quick Guide -->
    <div class="dashboard-card p-4">
        <h5 class="fw-bold mb-1">Quick Guide</h5>
        <p class="text-muted small mb-4">
            Follow these steps to manage employee information.
        </p>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="guide-item">
                    <div class="fw-semibold mb-2">
                        <span class="guide-number">01</span>
                        View Employees
                    </div>
                    <p class="text-muted small mb-0">
                        Browse and search employee records.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="guide-item">
                    <div class="fw-semibold mb-2">
                        <span class="guide-number">02</span>
                        Add Employees
                    </div>
                    <p class="text-muted small mb-0">
                        Enter details to create a new record.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="guide-item">
                    <div class="fw-semibold mb-2">
                        <span class="guide-number">03</span>
                        Edit Details
                    </div>
                    <p class="text-muted small mb-0">
                        Keep employee information up to date.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="guide-item">
                    <div class="fw-semibold mb-2">
                        <span class="guide-number">04</span>
                        Delete Records
                    </div>
                    <p class="text-muted small mb-0">
                        Remove records when appropriate.
                    </p>
                </div>
            </div>

        </div>
    </div>

</div>
